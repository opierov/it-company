<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.dao.EmployeeMapper">

    <insert id="insert" parameterType="org.example.models.Employee" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO employees (first_name, last_name, role, salary, skills)
        VALUES (#{firstName}, #{lastName}, #{role}, #{salary}, #{skills})
    </insert>

    <select id="getByDepartmentId" resultType="org.example.models.Employee" parameterType="Long">
        SELECT e.*
        FROM employees e
        JOIN teams t ON e.id = t.employees_id
        JOIN departments d ON t.id = d.teams_id
        WHERE d.id = #{departmentId}
    </select>

    <select id="getById" resultType="org.example.models.Employee" parameterType="Long">
        SELECT * FROM employees WHERE id = #{id}
    </select>

    <select id="getAll" resultType="org.example.models.Employee">
        SELECT * FROM employees
    </select>

    <select id="getByRole" resultType="org.example.models.Employee" parameterType="String">
        SELECT * FROM employees WHERE role = #{role}
    </select>

    <select id="getBySkill" resultType="org.example.models.Employee" parameterType="String">
        SELECT * FROM employees WHERE skills LIKE CONCAT('%', #{skill}, '%')
    </select>

    <select id="getBySalaryRange" resultType="org.example.models.Employee">
        SELECT * FROM employees WHERE salary BETWEEN #{minSalary} AND #{maxSalary}
    </select>

    <update id="update" parameterType="org.example.models.Employee">
        UPDATE employees
        SET first_name = #{firstName},
        last_name = #{lastName},
        role = #{role},
        salary = #{salary},
        skills = #{skills}
        WHERE id = #{id}
    </update>

    <update id="updateSkills">
        UPDATE employees SET skills = #{skills} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM employees WHERE id = #{id}
    </delete>

    <delete id="deleteBySalaryRange">
        DELETE FROM employees WHERE salary BETWEEN #{minSalary} AND #{maxSalary}
    </delete>

    <resultMap id="EmployeeResultMap" type="org.example.models.Employee">
        <id property="id" column="id"/>
        <result property="firstName" column="first_name"/>
        <result property="lastName" column="last_name"/>
        <result property="role" column="role"/>
        <result property="salary" column="salary"/>
        <result property="skills" column="skills"/>
        <association property="project" javaType="org.example.models.Project">
            <id property="id" column="projects_id"/>
            <result property="name" column="project_name"/>
        </association>
    </resultMap>

</mapper>
